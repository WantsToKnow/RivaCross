CXX = g++
CXXFLAGS = -Iinclude -Wno-multichar
WIN_LIBS = -luser32 -lgdi32 -lcomdlg32
GUI_OBJS = obj/Main.o obj/Core.o obj/RTSShared.o
OCAT_OBJS = obj/OCATMain.o obj/Core.o obj/OCATShared.o
CONSOLE_OBJS = obj/ConsoleMain.o obj/RivaCross.o obj/Core.o obj/RTSShared.o

all: RivaCross.exe

RivaCross.exe: $(GUI_OBJS)
	$(CXX) -mwindows -o $@ $^ $(WIN_LIBS) -lcomctl32 -lgdiplus

ocat: RivaCrossOCAT.exe ocat/bin/RivaCrossOCATHook64.dll

ocat/bin/RivaCrossOCATHook64.dll: src/OCATHook.cpp src/OCATWatchShared.h src/OCATStatus.h
	$(CXX) -Os -shared -static-libgcc -static-libstdc++ -s -o $@ src/OCATHook.cpp -luser32

RivaCrossOCAT.exe: $(OCAT_OBJS)
	$(CXX) -mwindows -o $@ $^ $(WIN_LIBS)

console: RivaCrossConsole.exe

RivaCrossConsole.exe: $(CONSOLE_OBJS)
	$(CXX) -o $@ $^ lib/pdcurses.a $(WIN_LIBS) -lgdiplus

obj/%.o: src/%.cpp
	$(CXX) -c $(CXXFLAGS) -o $@ $<

obj/OCATMain.o: src/Main.cpp src/OCATShared.h src/OCATCrosshairShared.h src/OCATStatus.h src/OCATWatchShared.h src/OCATProbeShared.h
	$(CXX) -c $(CXXFLAGS) -DRIVACROSS_OCAT -o $@ src/Main.cpp

obj/OCATShared.o: src/OCATStatus.h src/OCATWatchShared.h src/OCATProbeShared.h

clean:
	-rm -f RivaCross.exe RivaCrossOCAT.exe RivaCrossConsole.exe obj/*.o
