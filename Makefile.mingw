CXX = g++
CXXFLAGS = -Iinclude -Wno-multichar
WIN_LIBS = -luser32 -lgdi32 -lcomdlg32
GUI_OBJS = obj/Main.o obj/Core.o obj/RTSShared.o
CONSOLE_OBJS = obj/ConsoleMain.o obj/RivaCross.o obj/Core.o obj/RTSShared.o

all: RivaCross.exe

RivaCross.exe: $(GUI_OBJS)
	$(CXX) -mwindows -o $@ $^ $(WIN_LIBS)

console: RivaCrossConsole.exe

RivaCrossConsole.exe: $(CONSOLE_OBJS)
	$(CXX) -o $@ $^ lib/pdcurses.a $(WIN_LIBS)

obj/%.o: src/%.cpp
	$(CXX) -c $(CXXFLAGS) -o $@ $<

clean:
	-rm -f RivaCross.exe RivaCrossConsole.exe obj/*.o
