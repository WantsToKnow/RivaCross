@@ -147,6 +170,25 @@ void UpdateRivaCrossStatus(LONG stage, DWORD api)
   ReleaseSRWLockExclusive(&statusLock);
 }
 
+void RecordHookEntry(DWORD error)
+{
+  if (!InitOnceExecuteOnce(&statusOnce, InitStatus, nullptr, nullptr)) return;
+  if (statusView->callbackSeen && statusView->authorizationError == error) return;
+  AcquireSRWLockExclusive(&statusLock);
+  statusView->authorizationError = error;
+  MemoryBarrier();
+  InterlockedExchange(&statusView->callbackSeen, 1);
+  ReleaseSRWLockExclusive(&statusLock);
+}
+
+void RecordStartError(DWORD error)
+{
+  if (!InitOnceExecuteOnce(&statusOnce, InitStatus, nullptr, nullptr)) return;
+  AcquireSRWLockExclusive(&statusLock);
+  statusView->startError = error;
+  ReleaseSRWLockExclusive(&statusLock);
+}
