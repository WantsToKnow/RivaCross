-      _wcsicmp(processPath, snapshot.executable) == 0;
+  if (snapshot.magic != RIVACROSS_OCAT_WATCH_MAGIC ||
+      snapshot.version != RIVACROSS_OCAT_WATCH_VERSION ||
+      snapshot.executable[MAX_PATH - 1] != 0 || !snapshot.executable[0] ||
+      snapshot.mode < OCATWatchLaunch || snapshot.mode > OCATWatchRemote)
+    return reject(ERROR_INVALID_DATA);
+  if (!snapshot.heartbeat || (DWORD)(GetTickCount() - (DWORD)snapshot.heartbeat) >= 3000)
