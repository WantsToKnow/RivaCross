+  if (snapshot.controllerPid == pid || (snapshot.targetPid && snapshot.targetPid != pid) ||
+      (remoteOnly && (snapshot.mode != OCATWatchRemote || snapshot.targetPid != pid)) ||
+      _wcsicmp(processPath, snapshot.executable) != 0) return reject(ERROR_NOT_FOUND);
+  if (error) *error = ERROR_SUCCESS;
