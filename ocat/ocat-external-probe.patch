+// Runs only in the controller's short-lived probe process, before game loading.
+extern "C" __declspec(dllexport) DWORD WINAPI BuildRivaCrossHookCache(LPVOID value)
+{
+  const DWORD controller = static_cast<DWORD>(reinterpret_cast<ULONG_PTR>(value));
+  wchar_t name[80];
+  swprintf_s(name, L"%ls%lu", RIVACROSS_OCAT_PROBE_PREFIX, controller);
+  HANDLE mapping = OpenFileMappingW(FILE_MAP_WRITE, FALSE, name);
+  if (!mapping) return 0;
+  auto view = static_cast<OCATProbeShared *>(MapViewOfFile(mapping, FILE_MAP_WRITE,
+      0, 0, sizeof(OCATProbeShared)));
+  if (!view || view->magic != RIVACROSS_OCAT_PROBE_MAGIC ||
+      view->version != RIVACROSS_OCAT_PROBE_VERSION || view->controllerPid != controller) {
+    if (view) UnmapViewOfFile(view);
+    CloseHandle(mapping);
+    return 0;
+  }
+  OCATProbeShared result = {};
+  result.magic = RIVACROSS_OCAT_PROBE_MAGIC;
+  result.version = RIVACROSS_OCAT_PROBE_VERSION;
+  result.controllerPid = controller;
+  LONG ready = 0;
+  HMODULE dxgi = LoadLibraryW(L"dxgi.dll");
+  const auto createFactory = dxgi ? reinterpret_cast<decltype(&CreateDXGIFactory1)>(
+      GetProcAddress(dxgi, "CreateDXGIFactory1")) : nullptr;
+  ComPtr<IDXGIFactory1> factory;
+  HWND window = CreateWindowExW(0, L"STATIC", L"", WS_POPUP, 0, 0, 16, 16,
+      nullptr, nullptr, nullptr, nullptr);
+  if (window && createFactory && SUCCEEDED(createFactory(IID_PPV_ARGS(&factory)))) {
+    DXGI_SWAP_CHAIN_DESC desc = {};
+    desc.BufferDesc.Width = desc.BufferDesc.Height = 16;
+    desc.BufferDesc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    desc.SampleDesc.Count = 1;
+    desc.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+    desc.BufferCount = 2;
+    desc.OutputWindow = window;
+    desc.Windowed = TRUE;
+    desc.SwapEffect = DXGI_SWAP_EFFECT_FLIP_DISCARD;
+    {
+      HMODULE d3d11 = LoadLibraryW(L"d3d11.dll");
+      const auto create = d3d11 ? reinterpret_cast<decltype(&D3D11CreateDevice)>(
+          GetProcAddress(d3d11, "D3D11CreateDevice")) : nullptr;
+      ComPtr<ID3D11Device> device;
+      ComPtr<IDXGISwapChain> chain;
+      if (create && SUCCEEDED(create(nullptr, D3D_DRIVER_TYPE_HARDWARE, nullptr,
+          D3D11_CREATE_DEVICE_BGRA_SUPPORT, nullptr, 0, D3D11_SDK_VERSION, &device, nullptr, nullptr)) &&
+          SUCCEEDED(factory->CreateSwapChain(device.Get(), &desc, &chain)) &&
+          record_probe_targets(chain.Get(), result.d3d11)) ready |= 1;
+    }
+    {
+      HMODULE d3d12 = LoadLibraryW(L"d3d12.dll");
+      const auto create = d3d12 ? reinterpret_cast<decltype(&D3D12CreateDevice)>(
+          GetProcAddress(d3d12, "D3D12CreateDevice")) : nullptr;
+      ComPtr<ID3D12Device> device;
+      ComPtr<ID3D12CommandQueue> queue;
+      ComPtr<IDXGISwapChain> chain;
+      D3D12_COMMAND_QUEUE_DESC queueDesc = {};
+      queueDesc.Type = D3D12_COMMAND_LIST_TYPE_DIRECT;
+      if (create && SUCCEEDED(create(nullptr, D3D_FEATURE_LEVEL_11_0, IID_PPV_ARGS(&device))) &&
+          SUCCEEDED(device->CreateCommandQueue(&queueDesc, IID_PPV_ARGS(&queue))) &&
+          SUCCEEDED(factory->CreateSwapChain(queue.Get(), &desc, &chain)) &&
+          record_probe_targets(chain.Get(), result.d3d12) &&
+          record_probe_address(VTABLE(queue.Get())[10], result.execute)) ready |= 2;
+    }
+  }
+  factory.Reset();
+  if (window) DestroyWindow(window);
+  memcpy(view, &result, sizeof(result));
+  MemoryBarrier();
+  InterlockedExchange(&view->ready, ready);
+  UnmapViewOfFile(view);
+  CloseHandle(mapping);
+  return ready;
+}
+
+bool InstallCachedGraphicsHooks(DWORD controller)
+{
+  wchar_t name[80];
+  swprintf_s(name, L"%ls%lu", RIVACROSS_OCAT_PROBE_PREFIX, controller);
+  HANDLE mapping = OpenFileMappingW(FILE_MAP_READ, FALSE, name);
+  if (!mapping) { g_messageLog.LogWarning("dxgi", "External graphics cache unavailable"); return false; }
+  auto view = static_cast<const OCATProbeShared *>(MapViewOfFile(mapping, FILE_MAP_READ,
+      0, 0, sizeof(OCATProbeShared)));
+  OCATProbeShared cache = {};
+  if (view) { MemoryBarrier(); memcpy(&cache, view, sizeof(cache)); UnmapViewOfFile(view); }
+  CloseHandle(mapping);
+  if (cache.magic != RIVACROSS_OCAT_PROBE_MAGIC || cache.version != RIVACROSS_OCAT_PROBE_VERSION ||
+      cache.controllerPid != controller || !(cache.ready & 3)) return false;
+  bool installed = false;
+  DxgiTargets targets;
+  if ((cache.ready & 1) && resolve_probe_targets(cache.d3d11, targets)) {
+    installed = install_late_targets(targets, false);
+    g_messageLog.LogInfo("dxgi", installed ? "Cached D3D11 hooks installed" : "Cached D3D11 hooks failed");
+  }
+  void *execute = resolve_probe_address(cache.execute);
+  if ((cache.ready & 2) && execute && resolve_probe_targets(cache.d3d12, targets)) {
+    const bool queue = GameOverlay::install_hook(execute,
+        reinterpret_cast<GameOverlay::hook::address>(&LateExecuteCommandLists));
+    const bool success = queue && install_late_targets(targets, true);
+    installed = success || installed;
+    g_messageLog.LogInfo("dxgi", success ? "Cached D3D12 hooks installed" : "Cached D3D12 hooks failed");
+  } else if (cache.ready & 2) {
+    g_messageLog.LogWarning("dxgi", "Cached D3D12 module identity unavailable or mismatched; no target device probe");
+  }
+  return installed;
+}
