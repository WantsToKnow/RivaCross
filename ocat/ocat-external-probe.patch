+namespace {
+bool record_probe_address(void *address, OCATProbeAddress &result)
+{
+  HMODULE module = nullptr;
+  if (!address || !GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+      GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT, reinterpret_cast<LPCWSTR>(address), &module))
+    return false;
+  const DWORD length = GetModuleFileNameW(module, result.module, MAX_PATH);
+  if (!length || length >= MAX_PATH) return false;
+  const auto dos = reinterpret_cast<const IMAGE_DOS_HEADER *>(module);
+  if (dos->e_magic != IMAGE_DOS_SIGNATURE || dos->e_lfanew <= 0 || dos->e_lfanew > 4096) return false;
+  const auto nt = reinterpret_cast<const IMAGE_NT_HEADERS64 *>(
+      reinterpret_cast<const BYTE *>(module) + dos->e_lfanew);
+  if (nt->Signature != IMAGE_NT_SIGNATURE || nt->OptionalHeader.Magic != IMAGE_NT_OPTIONAL_HDR64_MAGIC) return false;
+  const auto offset = reinterpret_cast<const BYTE *>(address) - reinterpret_cast<const BYTE *>(module);
+  if (offset <= 0 || static_cast<size_t>(offset) >= nt->OptionalHeader.SizeOfImage) return false;
+  result.rva = static_cast<DWORD>(offset);
+  result.timestamp = nt->FileHeader.TimeDateStamp;
+  result.imageSize = nt->OptionalHeader.SizeOfImage;
+  return true;
+}
+
+bool record_probe_targets(IDXGISwapChain *chain, OCATProbeTargets &result)
+{
+  ComPtr<IDXGISwapChain1> chain1;
+  ComPtr<IDXGISwapChain3> chain3;
+  if (FAILED(chain->QueryInterface(IID_PPV_ARGS(&chain1))) ||
+      FAILED(chain->QueryInterface(IID_PPV_ARGS(&chain3)))) return false;
+  void *addresses[] = { VTABLE(chain)[8], VTABLE(chain1.Get())[22], VTABLE(chain)[13],
+      VTABLE(chain3.Get())[39], VTABLE(chain)[2] };
+  OCATProbeAddress *records[] = { &result.present, &result.present1, &result.resize,
+      &result.resize1, &result.release };
+  for (size_t i = 0; i < 5; ++i)
+    if (!in_system_dxgi(addresses[i]) || !record_probe_address(addresses[i], *records[i])) return false;
+  return true;
+}
+
+void *resolve_probe_address(const OCATProbeAddress &record)
+{
+  if (!record.rva || record.rva >= record.imageSize || !record.module[0] ||
+      record.module[MAX_PATH - 1] != 0) return nullptr;
+  HMODULE module = GetModuleHandleW(record.module);
+  wchar_t actual[MAX_PATH];
+  const DWORD length = module ? GetModuleFileNameW(module, actual, MAX_PATH) : 0;
+  if (!length || length >= MAX_PATH || _wcsicmp(actual, record.module)) return nullptr;
+  const auto dos = reinterpret_cast<const IMAGE_DOS_HEADER *>(module);
+  if (dos->e_magic != IMAGE_DOS_SIGNATURE || dos->e_lfanew <= 0 || dos->e_lfanew > 4096) return nullptr;
+  const auto nt = reinterpret_cast<const IMAGE_NT_HEADERS64 *>(
+      reinterpret_cast<const BYTE *>(module) + dos->e_lfanew);
+  if (nt->Signature != IMAGE_NT_SIGNATURE || nt->OptionalHeader.Magic != IMAGE_NT_OPTIONAL_HDR64_MAGIC ||
+      nt->FileHeader.TimeDateStamp != record.timestamp ||
+      nt->OptionalHeader.SizeOfImage != record.imageSize) return nullptr;
+  void *address = reinterpret_cast<BYTE *>(module) + record.rva;
+  MEMORY_BASIC_INFORMATION memory = {};
+  if (!VirtualQuery(address, &memory, sizeof(memory)) || memory.AllocationBase != module ||
+      memory.State != MEM_COMMIT || (memory.Protect & (PAGE_GUARD | PAGE_NOACCESS)) ||
+      !(memory.Protect & (PAGE_EXECUTE | PAGE_EXECUTE_READ | PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY)))
+    return nullptr;
+  return address;
+}
+
+bool resolve_probe_targets(const OCATProbeTargets &record, DxgiTargets &targets)
+{
+  targets.present = resolve_probe_address(record.present);
+  targets.present1 = resolve_probe_address(record.present1);
+  targets.resize = resolve_probe_address(record.resize);
+  targets.resize1 = resolve_probe_address(record.resize1);
+  targets.release = resolve_probe_address(record.release);
+  return in_system_dxgi(targets.present) && in_system_dxgi(targets.present1) &&
+      in_system_dxgi(targets.resize) && in_system_dxgi(targets.resize1) && in_system_dxgi(targets.release);
+}
+}
