+// Prime the shared DXGI factory methods before the game creates a swapchain.
+// This creates no D3D device, command queue, or swapchain in the game process.
+void InstallEarlyFactoryHooks()
+{
+  HMODULE dxgi = GetModuleHandleW(L"dxgi.dll");
+  const bool loadedHere = dxgi == nullptr;
+  if (loadedHere) dxgi = LoadLibraryW(L"dxgi.dll");
+  if (!dxgi) {
+    g_messageLog.LogWarning("dxgi", "Startup DXGI factory probe: runtime unavailable");
+    return;
+  }
+
+  const auto createFactory = GameOverlay::find_hook_trampoline(&CreateDXGIFactory1);
+  if (createFactory) {
+    ComPtr<IDXGIFactory2> factory;
+    const HRESULT hr = createFactory(IID_PPV_ARGS(&factory));
+    if (SUCCEEDED(hr)) {
+      hook_factory_object(factory.GetAddressOf());
+      g_messageLog.LogInfo("dxgi", "Startup DXGI factory method probe finished");
+    } else {
+      g_messageLog.LogWarning("dxgi", "Startup DXGI factory creation failed", hr);
+    }
+  } else {
+    g_messageLog.LogWarning("dxgi", "Startup DXGI factory trampoline unavailable");
+  }
+  if (loadedHere) FreeLibrary(dxgi);
+}
