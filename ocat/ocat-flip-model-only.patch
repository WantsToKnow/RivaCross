+// Draw only into a flip-model game back buffer. This checks eligibility, not
+// whether Windows actually used Independent Flip for a particular frame.
+bool flip_model_render_target(IDXGISwapChain *chain)
+{
+  DXGI_SWAP_CHAIN_DESC desc{};
+  return SUCCEEDED(chain->GetDesc(&desc)) &&
+      (desc.BufferUsage & DXGI_USAGE_RENDER_TARGET_OUTPUT) &&
+      (desc.SwapEffect == DXGI_SWAP_EFFECT_FLIP_DISCARD ||
+       desc.SwapEffect == DXGI_SWAP_EFFECT_FLIP_SEQUENTIAL);
+}
