+bool d3d12_renderer::WaitForIdle()
+{
+  if (!queue_ || !device_ || lateFenceValue_ == UINT64_MAX) return false;
+  if (!lateFence_) {
+    HRESULT hr = device_->CreateFence(0, D3D12_FENCE_FLAG_NONE,
+                                      IID_PPV_ARGS(&lateFence_));
+    if (FAILED(hr)) {
+      g_messageLog.LogError("D3D12", "WaitForIdle - CreateFence failed", hr);
+      return false;
+    }
+  }
+  const UINT64 target = ++lateFenceValue_;
+  HRESULT hr = queue_->Signal(lateFence_.Get(), target);
+  if (FAILED(hr)) {
+    g_messageLog.LogError("D3D12", "WaitForIdle - Signal failed", hr);
+    return false;
+  }
+  // Retain the fence in this renderer if the bounded wait expires.
+  const ULONGLONG deadline = GetTickCount64() + 5000;
+  for (;;) {
+    const UINT64 completed = lateFence_->GetCompletedValue();
+    if (completed >= target && completed != UINT64_MAX &&
+        SUCCEEDED(device_->GetDeviceRemovedReason())) return true;
+    if (completed == UINT64_MAX ||
+        FAILED(device_->GetDeviceRemovedReason()) ||
+        GetTickCount64() >= deadline) break;
+    Sleep(5);
+  }
+  g_messageLog.LogWarning("D3D12", "WaitForIdle - GPU completion unverified");
+  return false;
+}
