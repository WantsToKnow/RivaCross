+// A D3D12 swapchain does not expose the command queue used at creation time.
+// Capture the application's direct queue at ExecuteCommandLists, then match its
+// device to the swapchain before drawing.
+bool InstallLateD3D12Hook()
+{
+  g_messageLog.LogInfo("dxgi", "Late D3D12 probe started");
+  if (!GetModuleHandleW(L"d3d12.dll")) {
+    g_messageLog.LogInfo("dxgi", "Late D3D12 skipped: runtime not loaded");
+    return false;
+  }
+  g_messageLog.LogInfo("dxgi", "Late D3D12 loading runtime");
+  const HMODULE d3d12 = LoadLibraryW(L"d3d12.dll");
+  const HMODULE dxgi = GetModuleHandleW(L"dxgi.dll");
+  if (!d3d12 || !dxgi) {
+    g_messageLog.LogWarning("dxgi", "Late D3D12 runtime or DXGI unavailable");
+    if (d3d12) FreeLibrary(d3d12);
+    return false;
+  }
+
+  using CreateDeviceFn = HRESULT(WINAPI *)(IUnknown *, D3D_FEATURE_LEVEL, REFIID, void **);
+  using CreateFactoryFn = HRESULT(WINAPI *)(REFIID, void **);
+  const auto createDevice = reinterpret_cast<CreateDeviceFn>(
+      GetProcAddress(d3d12, "D3D12CreateDevice"));
+  const auto createFactory = reinterpret_cast<CreateFactoryFn>(
+      GetProcAddress(dxgi, "CreateDXGIFactory1"));
+  if (!createDevice || !createFactory) {
+    g_messageLog.LogWarning("dxgi", "Late D3D12 required export unavailable");
