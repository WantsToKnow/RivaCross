+  }
+
+  ComPtr<ID3D12Device> device;
+  ComPtr<ID3D12CommandQueue> queue;
+  ComPtr<IDXGIFactory1> factory;
+  ComPtr<IDXGISwapChain> chain;
+  HWND window = CreateWindowExW(0, L"STATIC", L"", WS_POPUP, 0, 0, 16, 16,
+                                nullptr, nullptr, nullptr, nullptr);
+  bool success = false;
+  do {
+    if (!window) {
+      g_messageLog.LogError("dxgi", "Late D3D12 temporary window failed", GetLastError());
+      break;
+    }
+    g_messageLog.LogInfo("dxgi", "Late D3D12 creating temporary device");
+    HRESULT hr = createDevice(nullptr, D3D_FEATURE_LEVEL_11_0,
+                              IID_PPV_ARGS(&device));
+    if (FAILED(hr)) {
+      g_messageLog.LogError("dxgi", "Late D3D12 temporary device failed", hr);
+      break;
+    }
+    D3D12_COMMAND_QUEUE_DESC queueDesc{};
+    queueDesc.Type = D3D12_COMMAND_LIST_TYPE_DIRECT;
+    g_messageLog.LogInfo("dxgi", "Late D3D12 creating temporary queue");
+    hr = device->CreateCommandQueue(&queueDesc, IID_PPV_ARGS(&queue));
+    if (FAILED(hr)) {
+      g_messageLog.LogError("dxgi", "Late D3D12 temporary queue failed", hr);
+      break;
+    }
+    g_messageLog.LogInfo("dxgi", "Late D3D12 creating DXGI factory");
+    hr = createFactory(IID_PPV_ARGS(&factory));
+    if (FAILED(hr)) {
+      g_messageLog.LogError("dxgi", "Late D3D12 DXGI factory failed", hr);
+      break;
+    }
+    DXGI_SWAP_CHAIN_DESC desc{};
+    desc.BufferDesc.Width = 16;
+    desc.BufferDesc.Height = 16;
+    desc.BufferDesc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    desc.SampleDesc.Count = 1;
+    desc.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+    desc.BufferCount = 2;
+    desc.OutputWindow = window;
+    desc.Windowed = TRUE;
+    desc.SwapEffect = DXGI_SWAP_EFFECT_FLIP_DISCARD;
+    using CreateSwapChainFn = HRESULT(STDMETHODCALLTYPE *)(IDXGIFactory *, IUnknown *,
+        DXGI_SWAP_CHAIN_DESC *, IDXGISwapChain **);
+    auto original = reinterpret_cast<CreateSwapChainFn>(VTABLE(factory.Get())[10]);
+    if (original == &IDXGIFactory_CreateSwapChain)
+      original = GameOverlay::find_hook_trampoline(&IDXGIFactory_CreateSwapChain);
+    if (!original) {
+      g_messageLog.LogWarning("dxgi", "Late D3D12 CreateSwapChain target unavailable");
+      break;
+    }
+    g_messageLog.LogInfo("dxgi", "Late D3D12 creating temporary swapchain");
+    hr = original(factory.Get(), queue.Get(), &desc, &chain);
+    if (FAILED(hr)) {
+      g_messageLog.LogError("dxgi", "Late D3D12 temporary swapchain failed", hr);
+      break;
+    }
+    void *execute = VTABLE(queue.Get())[10];
+    if (!execute) {
+      g_messageLog.LogWarning("dxgi", "Late D3D12 ExecuteCommandLists target unavailable");
+      break;
+    }
+    g_messageLog.LogInfo("dxgi", "Late D3D12 installing swapchain hooks");
+    if (!install_late_swapchain_hooks(chain.Get(), true)) {
+      g_messageLog.LogWarning("dxgi", "Late D3D12 swapchain hooks unavailable");
+      break;
+    }
+    g_messageLog.LogInfo("dxgi", "Late D3D12 installing queue hook");
+    success = GameOverlay::install_hook(execute,
+        reinterpret_cast<GameOverlay::hook::address>(&LateExecuteCommandLists));
+    if (!success) g_messageLog.LogWarning("dxgi", "Late D3D12 queue hook unavailable");
+  } while (false);
+
+  chain.Reset(); factory.Reset(); queue.Reset(); device.Reset();
+  if (window) DestroyWindow(window);
+  FreeLibrary(d3d12);
+  g_messageLog.LogInfo("dxgi", success ? "Late D3D12 hooks installed" :
+                                     "Late D3D12 hooks unavailable");
+  return success;
+}
