   g_messageLog.LogVerbose("hook::install", "Status: " + std::string(MH_StatusToString(statuscode)));
-  if (statuscode == MH_OK || statuscode == MH_ERROR_ALREADY_CREATED) {
-    enable();
+  if (statuscode == MH_OK && trampoline && trampoline != target) {
     return status::success;
   }
 
+  // An existing hook does not provide this caller's original trampoline.
+  if (statuscode == MH_OK) MH_RemoveHook(target);
+  trampoline = nullptr;
+
   if (--s_reference_count == 0) {
     MH_Uninitialize();
   }
 
