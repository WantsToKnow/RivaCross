+
+bool DLLInjection::ExecuteStartRemoteRenderer(void* dllModule)
+{
+  // Resolve the export locally, then apply its RVA to the same image in the
+  // target. DONT_RESOLVE_DLL_REFERENCES reads exports without running OCAT code.
+  HMODULE local = LoadLibraryExW(arguments_.dllPath.c_str(), NULL,
+                                 DONT_RESOLVE_DLL_REFERENCES);
+  if (!local) {
+    g_messageLog.LogError("DLLInjector", "Could not read local OCAT exports", GetLastError());
+    return false;
+  }
+  FARPROC exportAddress = GetProcAddress(local, "StartRemoteRenderer");
+  const uintptr_t offset = exportAddress ?
+    reinterpret_cast<uintptr_t>(exportAddress) - reinterpret_cast<uintptr_t>(local) : 0;
+  FreeLibrary(local);
+  if (!exportAddress) {
+    g_messageLog.LogError("DLLInjector", "StartRemoteRenderer export missing");
+    return false;
+  }
+  if (offset >= remoteDLLSize_) {
+    g_messageLog.LogError("DLLInjector", "Remote OCAT image does not match local export");
+    return false;
+  }
+  const auto remote = reinterpret_cast<PTHREAD_START_ROUTINE>(
+    reinterpret_cast<uintptr_t>(dllModule) + offset);
+  return ExecuteRemoteThread(remote, NULL);
 }
 
