+  // Skip this overlay frame if our GPU work is not yet complete.
+  if (!WaitForFence(frameFences_[backBufferIndex].Get(),
+                    frameFenceValues_[backBufferIndex],
+                    frameFenceEvents_[backBufferIndex]))
+    return false;
 
   HRESULT hr = commandPool_[backBufferIndex]->Reset();
 
@@ -282,7 +289,12 @@ bool d3d12_renderer::CreateFrameFences()
       g_messageLog.LogError("D3D12", "Create Fence failed", hr);
