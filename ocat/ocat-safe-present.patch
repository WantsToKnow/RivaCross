+    HANDLE event = CreateEvent(nullptr, FALSE, FALSE, nullptr);
+    if (!event) {
+      g_messageLog.LogError("D3D12", "Create Fence event failed", GetLastError());
+      return false;
+    }
+    frameFenceEvents_.push_back(event);
     frameFenceValues_.push_back(0);
   }
   return true;
@@ -706,7 +718,12 @@ void d3d12_renderer::DrawOverlay(int currentIndex, bool lagIndicatorState)
   ID3D12CommandList* commandLists[] = {commandList_.Get()};
   queue_->ExecuteCommandLists(1, commandLists);
 
-  queue_->Signal(frameFences_[currentIndex].Get(), currFenceValue_);
+  hr = queue_->Signal(frameFences_[currentIndex].Get(), currFenceValue_);
+  if (FAILED(hr)) {
+    g_messageLog.LogError("D3D12", "DrawOverlay - Signal queue failed", hr);
+    initSuccessfull_ = false;
+    return;
+  }
   frameFenceValues_[currentIndex] = currFenceValue_;
   ++currFenceValue_;
 }
