@@ -119,12 +119,16 @@ d3d12_renderer::~d3d12_renderer()
 }
 
 namespace {
-void WaitForFence(ID3D12Fence* fence, UINT64 completionValue, HANDLE waitEvent)
+bool WaitForFence(ID3D12Fence* fence, UINT64 completionValue, HANDLE waitEvent)
 {
-  if (fence->GetCompletedValue() < completionValue) {
-    fence->SetEventOnCompletion(completionValue, waitEvent);
-    WaitForSingleObject(waitEvent, INFINITE);
-  }
+  const UINT64 completed = fence->GetCompletedValue();
+  if (completed == UINT64_MAX) return false;
+  if (completed >= completionValue) return true;
+  if (!waitEvent || FAILED(fence->SetEventOnCompletion(completionValue, waitEvent)))
+    return false;
+  if (WaitForSingleObject(waitEvent, 5) != WAIT_OBJECT_0) return false;
+  const UINT64 afterWait = fence->GetCompletedValue();
+  return afterWait != UINT64_MAX && afterWait >= completionValue;
 }
 }  // namespace
 
