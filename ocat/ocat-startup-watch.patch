+namespace {
+INIT_ONCE watchOnce = INIT_ONCE_STATIC_INIT;
+HANDLE watchMapping = nullptr;
+const OCATWatchShared* watchView = nullptr;
+wchar_t processPath[MAX_PATH] = {};
+volatile LONG rendererStarted = 0;
+
+BOOL CALLBACK OpenWatch(PINIT_ONCE, PVOID, PVOID*)
+{
+  DWORD length = GetModuleFileNameW(nullptr, processPath, MAX_PATH);
+  if (!length || length >= MAX_PATH) return FALSE;
+  watchMapping = OpenFileMappingW(FILE_MAP_READ, FALSE, RIVACROSS_OCAT_WATCH_NAME);
+  if (!watchMapping) return FALSE;
+  watchView = static_cast<const OCATWatchShared*>(MapViewOfFile(
+      watchMapping, FILE_MAP_READ, 0, 0, sizeof(OCATWatchShared)));
+  if (!watchView) {
+    CloseHandle(watchMapping);
+    watchMapping = nullptr;
+    return FALSE;
+  }
+  return TRUE;
+}
+}
+
+bool RivaCrossWatchAllowed(bool remoteOnly = false)
+{
+  if (!InitOnceExecuteOnce(&watchOnce, OpenWatch, nullptr, nullptr)) return false;
+  const LONG sequence = watchView->sequence;
+  if (sequence & 1) return false;
+  MemoryBarrier();
+  OCATWatchShared snapshot;
+  memcpy(&snapshot, watchView, sizeof(snapshot));
+  MemoryBarrier();
+  if (sequence != watchView->sequence) return false;
+  const DWORD pid = GetCurrentProcessId();
+  return snapshot.magic == RIVACROSS_OCAT_WATCH_MAGIC &&
+      snapshot.version == RIVACROSS_OCAT_WATCH_VERSION &&
+      snapshot.controllerPid != pid && snapshot.heartbeat &&
+      (DWORD)(GetTickCount() - (DWORD)snapshot.heartbeat) < 3000 &&
+      snapshot.mode >= OCATWatchLaunch && snapshot.mode <= OCATWatchRemote &&
+      (!remoteOnly || (snapshot.mode == OCATWatchRemote && snapshot.targetPid == pid)) &&
+      (!snapshot.targetPid || snapshot.targetPid == pid) &&
+      snapshot.executable[MAX_PATH - 1] == 0 && snapshot.executable[0] &&
+      _wcsicmp(processPath, snapshot.executable) == 0;
+}
 
