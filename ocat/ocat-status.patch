+namespace {
+// Process lifetime: in-flight Present callbacks may outlive hook removal.
+INIT_ONCE statusOnce = INIT_ONCE_STATIC_INIT;
+SRWLOCK statusLock = SRWLOCK_INIT;
+HANDLE statusMapping = nullptr;
+OCATStatusShared* statusView = nullptr;
+
+BOOL CALLBACK InitStatus(PINIT_ONCE, PVOID, PVOID*)
+{
+  wchar_t name[80];
+  swprintf_s(name, L"Local\\RivaCrossOCATStatusV1-%lu", GetCurrentProcessId());
+  statusMapping = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE,
+                                    0, sizeof(OCATStatusShared), name);
+  if (!statusMapping) return FALSE;
+  statusView = static_cast<OCATStatusShared*>(MapViewOfFile(
+      statusMapping, FILE_MAP_WRITE, 0, 0, sizeof(OCATStatusShared)));
+  if (!statusView) {
+    CloseHandle(statusMapping);
+    statusMapping = nullptr;
+    return FALSE;
+  }
+  statusView->magic = RIVACROSS_OCAT_STATUS_MAGIC;
+  statusView->version = RIVACROSS_OCAT_STATUS_VERSION;
+  statusView->api = 0;
+  InterlockedExchange(&statusView->stage, 1);
+  return TRUE;
+}
+}
+
+void UpdateRivaCrossStatus(LONG stage, DWORD api)
+{
+  if (!InitOnceExecuteOnce(&statusOnce, InitStatus, nullptr, nullptr)) return;
+  if (stage < statusView->stage ||
+      (stage == statusView->stage && (!api || api == statusView->api))) return;
+  AcquireSRWLockExclusive(&statusLock);
+  if (stage >= statusView->stage) {
+    if (api) statusView->api = api;
+    MemoryBarrier();
+    InterlockedExchange(&statusView->stage, stage);
+  }
+  ReleaseSRWLockExclusive(&statusLock);
+}
+
 DWORD WINAPI InstallLateD3D11HookThread(LPVOID)
 {
+  UpdateRivaCrossStatus(1);
   g_messageLog.LogInfo("dxgi", "Late hook worker started");
   InstallLateD3D12Hook();
   g_messageLog.LogInfo("dxgi", "Late D3D12 probe finished");
@@ -66,6 +112,7 @@ DWORD WINAPI InstallLateD3D11HookThread(LPVOID)
 extern "C" __declspec(dllexport) LRESULT CALLBACK
 GlobalHookProc(int code, WPARAM wParam, LPARAM lParam)
 {
+  UpdateRivaCrossStatus(1);
   return CallNextHookEx(NULL, code, wParam, lParam);
 }
 
