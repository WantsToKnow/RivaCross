+// Per-process renderer progress, read by RivaCrossOCAT.exe.
+#define RIVACROSS_OCAT_STATUS_MAGIC 0x53544352u
+#define RIVACROSS_OCAT_STATUS_VERSION 1u
+
+struct OCATStatusShared {
+  DWORD magic;
+  DWORD version;
+  volatile LONG stage; // 1: DLL code ran, 2: Present reached, 3: draw commands issued
+  DWORD api;            // 0: unknown, 11: D3D11, 12: D3D12
+};
+
+void UpdateRivaCrossStatus(LONG stage, DWORD api = 0);
